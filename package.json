{
    "name": "@btc-vision/wallet-sdk",
    "version": "1.1.0",
    "description": "OP_WALLET SDK",
    "keywords": [
        "bitcoin",
        "keyring"
    ],
    "homepage": "https://github.com/btc-vision/wallet-sdk#readme",
    "bugs": {
        "url": "https://github.com/btc-vision/wallet-sdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/btc-vision/wallet-sdk.git"
    },
    "license": "ISC",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:lib": "vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "test": "vitest run --coverage",
        "prepublishOnly": "npm run build",
        "lint": "eslint ./src",
        "clean": "rimraf dist lib es"
    },
    "dependencies": {
        "@bitcoinerlab/secp256k1": "^1.2.0",
        "@btc-vision/bip32": "^6.0.3",
        "@btc-vision/bitcoin": "^6.4.11",
        "@keystonehq/keystone-sdk": "^0.11.5",
        "@noble/secp256k1": "^2.3.0",
        "@vitest/coverage-v8": "^4.0.14",
        "big-integer": "^1.6.52",
        "bignumber.js": "^9.3.1",
        "bip-schnorr": "^0.6.7",
        "bip39": "^3.1.0",
        "bitcoinjs-lib": "^7.0.0",
        "bs58check": "^4.0.0",
        "chrome": "^0.1.0",
        "ecpair": "^2.1.0",
        "hdkey": "^2.1.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vitest": "^4.0.14"
    },
    "devDependencies": {
        "@types/bitcore-lib": "^0.15.6",
        "@types/chai": "^5.2.3",
        "@types/chrome": "^0.1.31",
        "@types/hdkey": "^2.1.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "@vitejs/plugin-react": "^5.1.1",
        "clean-webpack-plugin": "^4.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-webpack-plugin": "^5.0.2",
        "glob": "^13.0.0",
        "prettier": "^3.7.3",
        "ts-node": "^10.9.2",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.2.6",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-node-polyfills": "^0.24.0",
        "watch": "^1.0.2",
        "watchify": "^4.0.0"
    },
    "engines": {
        "node": ">=21.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
