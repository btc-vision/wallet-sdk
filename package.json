{
    "name": "@btc-vision/wallet-sdk",
    "version": "2.2.1",
    "description": "OPNet Wallet SDK - Bitcoin wallet with post-quantum cryptography support (BIP360)",
    "keywords": [
        "bitcoin",
        "wallet",
        "keyring",
        "bip32",
        "bip39",
        "bip360",
        "quantum",
        "mldsa",
        "opnet"
    ],
    "homepage": "https://github.com/btc-vision/wallet-sdk#readme",
    "bugs": {
        "url": "https://github.com/btc-vision/wallet-sdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/btc-vision/wallet-sdk.git"
    },
    "license": "ISC",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:lib": "vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "test": "vitest run --coverage",
        "test:watch": "vitest watch",
        "prepublishOnly": "npm run build",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix",
        "clean": "rimraf dist lib es"
    },
    "dependencies": {
        "@btc-vision/bip32": "^7.1.2",
        "@btc-vision/bitcoin": "^7.0.0",
        "@btc-vision/ecpair": "^4.0.5",
        "@btc-vision/transaction": "^1.8.7-beta.0",
        "opnet": "^1.8.14-rc.1"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "@typescript-eslint/eslint-plugin": "^8.59.0",
        "@typescript-eslint/parser": "^8.59.0",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.0",
        "vite": "^8.0.10",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-node-polyfills": "^0.26.0",
        "vitest": "^4.1.5"
    },
    "engines": {
        "node": ">=21.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
