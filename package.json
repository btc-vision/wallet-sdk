{
  "name": "@btc-vision/wallet-sdk",
  "version": "1.0.8",
  "description": "OP_WALLET SDK",
  "keywords": [
    "bitcoin",
    "keyring"
  ],
  "homepage": "https://github.com/btc-vision/wallet-sdk#readme",
  "bugs": {
    "url": "https://github.com/btc-vision/wallet-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/btc-vision/wallet-sdk.git"
  },
  "license": "ISC",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "mocha -r ts-node/register test/**/*.ts --timeout 300000",
    "prepublishOnly": "npm run build",
    "lint": "eslint ./src ./test",
    "clean": "rimraf dist lib es"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@btc-vision/bitcoin": "^6.4.8",
    "@keystonehq/keystone-sdk": "^0.9.1",
    "@noble/secp256k1": "^2.2.2",
    "big-integer": "^1.6.52",
    "bignumber.js": "^9.1.2",
    "bip-schnorr": "^0.6.7",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "bitcore-lib": "^10.7.0",
    "bs58check": "^4.0.0",
    "chrome": "^0.1.0",
    "ecpair": "^2.1.0",
    "hdkey": "^2.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bitcore-lib": "^0.15.6",
    "@types/chai": "^5.0.1",
    "@types/chrome": "^0",
    "@types/hdkey": "^2.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.1",
    "chai": "^5.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "cross-env": "^7.0.3",
    "eslint": "9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-webpack-plugin": "^4.2.0",
    "glob": "^11.0.1",
    "mocha": "11.0.1",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "watch": "^1.0.2",
    "watchify": "^4.0.0"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "packageManager": "yarn@4.6.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
