{
    "name": "@btc-vision/wallet-sdk",
    "version": "2.0.12",
    "description": "OPNet Wallet SDK - Bitcoin wallet with post-quantum cryptography support (BIP360)",
    "keywords": [
        "bitcoin",
        "wallet",
        "keyring",
        "bip32",
        "bip39",
        "bip360",
        "quantum",
        "mldsa",
        "opnet"
    ],
    "homepage": "https://github.com/btc-vision/wallet-sdk#readme",
    "bugs": {
        "url": "https://github.com/btc-vision/wallet-sdk/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/btc-vision/wallet-sdk.git"
    },
    "license": "ISC",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.esm.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:lib": "vite build",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "test": "vitest run --coverage",
        "test:watch": "vitest watch",
        "prepublishOnly": "npm run build",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix",
        "clean": "rimraf dist lib es"
    },
    "dependencies": {
        "@bitcoinerlab/secp256k1": "^1.2.0",
        "@btc-vision/bip32": "^6.0.3",
        "@btc-vision/bitcoin": "^6.4.11",
        "@btc-vision/transaction": "^1.7.14",
        "@keystonehq/keystone-sdk": "^0.11.5",
        "ecpair": "^2.1.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@typescript-eslint/eslint-plugin": "^8.48.0",
        "@typescript-eslint/parser": "^8.48.0",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.0.14",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.7.3",
        "rimraf": "^6.0.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.2.6",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-node-polyfills": "^0.24.0",
        "vitest": "^4.0.14"
    },
    "engines": {
        "node": ">=21.0.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    }
}
